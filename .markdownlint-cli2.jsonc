// Configuration for markdownlint-cli2
// See: https://github.com/DavidAnson/markdownlint-cli2#configuration
//
// Rule configuration lives in .markdownlint.json (auto-discovered by
// markdownlint-cli2 when present in the same directory).
{
  // Directories to exclude from linting. "**/target/**" also prunes the
  // ignored nested Cargo trees built by repository test fixtures (e.g.
  // tests/godot-web-smoke/target).
  "ignores": [
    "**/target/**",
    "site/**",
    ".git/**",
    ".venv/**",
    "node_modules/**",
    "progress/**",
    "mutants.out*/**",
    "logs/**",
    "PLAN.md"
  ]
}
